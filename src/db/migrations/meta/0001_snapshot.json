        },
        "orders_timestamp_order": {
          "name": "orders_timestamp_order",
          "value": "\n    (\"orders\".\"submitted_at\" IS NULL OR \"orders\".\"submitted_at\" >= \"orders\".\"created_at\") AND\n    (\"orders\".\"verified_at\" IS NULL OR \"orders\".\"verified_at\" >= \"orders\".\"submitted_at\") AND\n    (\"orders\".\"delivered_at\" IS NULL OR \"orders\".\"delivered_at\" >= \"orders\".\"verified_at\")"
        }
