          "name": "orders_submission_state",
          "value": "\n    (\"orders\".\"status\" = 'pending' AND \"orders\".\"trx_id\" IS NULL AND \"orders\".\"submitted_at\" IS NULL)\n    OR (\"orders\".\"status\" <> 'pending' AND \"orders\".\"trx_id\" IS NOT NULL AND \"orders\".\"submitted_at\" IS NOT NULL)"
        },
        "orders_verification_state": {
          "name": "orders_verification_state",
          "value": "\n    (\"orders\".\"status\" IN ('verified', 'delivered', 'refunded') AND \"orders\".\"verified_at\" IS NOT NULL)\n    OR (\"orders\".\"status\" IN ('pending', 'submitted', 'rejected') AND \"orders\".\"verified_at\" IS NULL)"
