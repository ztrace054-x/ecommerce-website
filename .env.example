# Closed preview needs no credentials. Leave every committed value blank.
# Never put real values in this committed template.

# Existing native PostgreSQL tools; hosted APIs use Supabase HTTP.
DATABASE_URL=

# Turnstile: only the site key is public; the secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only email credential; email sending is not enabled.
RESEND_API_KEY=

# Reserved for a reviewed future server purpose. Not an admin login password.
ADMIN_SECRET=

# Existing AES-GCM voucher/legacy TOTP helpers; no live voucher inventory.
ENCRYPTION_KEY=

# Marketplace runtime configuration. Supply actual values only in the host secret store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
CHECKOUT_ENABLED=
POLICIES_APPROVED=
CATALOG_APPROVED=
BKASH_RECIPIENT_NUMBER=
BKASH_PAYMENT_METHOD=
TRUSTED_CLIENT_IP_HEADER=
SUPPORT_WHATSAPP_NUMBER=
SUPPORT_EMAIL=

# Existing native PostgreSQL workflow
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
POSTGRES_PASSWORD=
