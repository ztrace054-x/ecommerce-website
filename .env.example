# Template only. Leave every committed value blank.
# Never put real values in this committed template.

# Server-only PostgreSQL connection for the order API.
DATABASE_URL=

# Turnstile: only the site key is public; the order API verifies server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only email credential; no emails are sent in Phase 0.
RESEND_API_KEY=

# Reserved for a reviewed future server purpose. Not an admin login password.
ADMIN_SECRET=

# Server-only voucher encryption key; encryption setup is deferred.
ENCRYPTION_KEY=

# Order API: server-only configuration. Keep placeholders blank.
# Origins: comma-separated exact origins; proxy: vercel (default).
# Local proxy mode is only for isolated development or loopback smoke tests.
# IP hash secret: at least 32 random characters. Configure securely, never in Git.
# WhatsApp: international digits 8801...; bKash: canonical 01...
# LOCAL_ORDER_SMOKE and ALLOW_LOCAL_SEED are loopback-only test opt-ins, never live.
IP_HASH_SECRET=
ALLOWED_ORIGINS=
TRUSTED_PROXY_MODE=
ADMIN_WHATSAPP_NUMBER=
BKASH_RECIPIENT_NUMBER=
LOCAL_ORDER_SMOKE=
ALLOW_LOCAL_SEED=

# Required canonical origin, e.g. http://localhost:3000 locally; HTTPS in production.
SITE_ORIGIN=
# Local synthetic contact/payment examples only: 8801000000000 / 01000000000.
